{
  "name": "Meow Image Compressor",
  "short_name": "Meow",
  "description": "Unlimited, private image compression that runs entirely on your device.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#181926",
  "theme_color": "#181926",
  "categories": ["utilities", "photo"],
  "icons": [
